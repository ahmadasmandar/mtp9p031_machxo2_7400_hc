         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MT9P031 - 1/2.5-inch 5 MP CMOS Digital Image Sensor</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The onsemi MT9P031 is a 1/2.5-inch CMOS active-pixel digital&#xD;&#xA;image sensor with an active imaging pixel array of 2592 H x 1944 V.</rdf:li>
            </rdf:Alt>
         </dc:description>
